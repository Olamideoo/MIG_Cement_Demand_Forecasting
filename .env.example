# Copy to .env and adjust. .env is gitignored - never commit real credentials.

DB_PATH=DATA/raw/MIG_Cement_Records.db
INTERIM_DIR=DATA/interim
PROCESSED_DIR=DATA/processed

# The tracking server, not a directory. Start it with `make mlflow`, or
# `docker compose -f docker/docker-compose.yml up -d mlflow`. Training still
# works when it is down - the run simply is not recorded.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=mig-cement-forecasting
MODEL_NAME=rf_demand_forecaster
MODEL_STAGE=Staging

API_HOST=0.0.0.0
API_PORT=8000
# Set this and the dashboard calls the API. Comment it out and the
# dashboard loads the model directly instead.
API_BASE_URL=http://localhost:8000
DASHBOARD_PORT=8501

FORECAST_HORIZON_WEEKS=8
TRAIN_END=2024-06-30
VAL_END=2024-09-30

# Inventory assumptions - not present in source data, sensitivity-test these
LEAD_TIME_DAYS=3
SERVICE_LEVEL_Z=2.05

# AWS (phase 8)
# AWS_REGION=eu-west-2
# ECR_REGISTRY=
